  "dependencies": {
    "@github/copilot-sdk": "1.0.30",
    "@microsoft/teams.apps": "2.2.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cross-spawn": "7.0.6",
    "zod": "4.6.7"
  }
}
