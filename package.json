{
  "name": "teams-agent-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup": "node src/setup.js",
    "start": "node --env-file=.env src/server.js",
